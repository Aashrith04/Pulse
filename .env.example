# ==========================================
# PULSE — ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================
# All variables are optional for out-of-the-box local demo mode.
# Configure real credentials when connecting live services.

PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Kolkata

# ------------------------------------------
# STORAGE MODE (LOCAL JSON vs SUPABASE CLOUD)
# ------------------------------------------
# 'local' uses server/data/pulse.db.json (default offline demo mode)
# 'cloud' uses live Supabase PostgreSQL (requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY)
# If cloud mode fails, it returns diagnostic errors and NEVER silently falls back to local.
PULSE_STORAGE_MODE=local

# ------------------------------------------
# DATABASE (SUPABASE / POSTGRESQL) [OPTIONAL]
# ------------------------------------------
# If not provided, Pulse runs with local ACID-safe file storage (server/data/pulse.db.json)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------
# AI PROVIDER ORCHESTRATION [OPTIONAL]
# ------------------------------------------
# Pulse automatically switches to intelligent local deterministic fallback when keys are absent.
# You can also configure keys securely inside the Settings UI at runtime.
AI_PRIMARY_PROVIDER=openai # Options: openai, anthropic, xai, fallback

OPENAI_API_KEY=sk-placeholder-openai-key
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

XAI_API_KEY=xai-placeholder-grok-key
XAI_MODEL=grok-2-1212

# ------------------------------------------
# NEWS & RSS INGESTION [OPTIONAL]
# ------------------------------------------
# Pulse automatically pulls live RSS/Atom feeds (PIB India, The Hindu, BBC, Express) without keys.
NEWS_API_KEY=your-newsapi-org-key-if-used
ENABLE_AUTO_INGESTION=true
INGESTION_INTERVAL_MINUTES=30

# ------------------------------------------
# HOURLY PULSE SCHEDULER
# ------------------------------------------
HOURLY_PULSE_CRON=0 * * * *
ENABLE_BACKGROUND_SCHEDULER=true

# ------------------------------------------
# QUIET NOTIFICATION SYSTEM
# ------------------------------------------
NOTIFICATION_ROLLING_HOURS=3
NOTIFICATION_MAX_PER_WINDOW=2
NOTIFICATION_STORY_COOLDOWN_HOURS=6
