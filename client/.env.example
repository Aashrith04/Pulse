# ============================================================================
# PULSE CLIENT — ENVIRONMENT CONFIGURATION (client/.env.example)
# ============================================================================
# Build-time environment variable for Vite.
# In local development: defaults to '/api' (proxied by Vite dev server to localhost:3001)
# In production on Render: set to your deployed backend URL (e.g., https://pulse-backend.onrender.com/api)
# ============================================================================

VITE_API_BASE_URL=http://localhost:3001/api
