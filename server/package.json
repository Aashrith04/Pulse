{
  "name": "pulse-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate": "tsx src/db/migrateLocalToSupabase.ts",
    "migrate:dry-run": "tsx src/db/migrateLocalToSupabase.ts --dry-run",
    "migrate:cloud": "tsx src/db/migrateLocalToSupabase.ts",
    "verify:cloud": "tsx src/db/verifyCloudSchema.ts",
    "verify:counts": "tsx src/db/verifyRowCounts.ts",
    "test:live-auth": "tsx src/db/testLiveAuthenticationAndRLS.ts",
    "backup": "tsx src/db/backupDatabase.ts",
    "restore": "tsx src/db/restoreCloudBackup.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
