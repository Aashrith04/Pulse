# ============================================================================
# PULSE SERVER — ENVIRONMENT CONFIGURATION (server/.env.example)
# ============================================================================
# Copy this template to server/.env and populate with your project credentials.
# NEVER commit server/.env to version control!
# ============================================================================

PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TIMEZONE=Asia/Kolkata

# ----------------------------------------------------------------------------
# 1. STORAGE MODE & REPOSITORY CONFIGURATION
# ----------------------------------------------------------------------------
# Set storage mode: 'local' (offline demo mode using pulse.db.json) or 'cloud' (Supabase PostgreSQL)
# Cloud mode strictly requires valid SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# If cloud mode loses database connection, it returns diagnostic errors and NEVER silently switches to local storage.
PULSE_STORAGE_MODE=local

# ----------------------------------------------------------------------------
# 2. SUPABASE CLOUD DATABASE & AUTH (REQUIRED FOR CLOUD PERSISTENCE)
# ----------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys
# Supports both legacy JWT tokens (eyJ...) and new publishable key format (sbp_...)
SUPABASE_ANON_KEY=
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys
# Strictly server-side secret! Supports legacy service_role JWT (eyJ...) and new secret key (sbs_...)
# NEVER expose this key to client-side code or browser bundles!
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Direct PostgreSQL URI for executing migrations or CLI administration
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# ----------------------------------------------------------------------------
# 2. ADMINISTRATIVE ACCESS & API SECURITY
# ----------------------------------------------------------------------------
# Secret key protecting /api/admin/* manual triggers and diagnostic routes (sent via X-Admin-Key)
# MUST be rotated before production deployment! (Generate with: openssl rand -hex 32)
ADMIN_API_KEY=replace-with-secure-32-byte-hex-secret

# ----------------------------------------------------------------------------
# 3. WEB PUSH (VAPID) BROWSER NOTIFICATIONS
# ----------------------------------------------------------------------------
# Generated via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pulse.news

# ----------------------------------------------------------------------------
# 4. MULTI-MODEL AI PROVIDERS (OPTIONAL — FALLBACK ENGINE ACTIVE BY DEFAULT)
# ----------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=fallback # Options: anthropic, openai, xai, fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
XAI_API_KEY=
XAI_MODEL=grok-2-1212

# ----------------------------------------------------------------------------
# 5. SCHEDULER & NOTIFICATION FREQUENCY
# ----------------------------------------------------------------------------
ENABLE_AUTO_INGESTION=true
INGESTION_INTERVAL_MINUTES=30
HOURLY_PULSE_CRON=0 * * * *
NOTIFICATION_ROLLING_HOURS=3
NOTIFICATION_MAX_PER_WINDOW=2
NOTIFICATION_STORY_COOLDOWN_HOURS=6
